# Template for .env. Copy it to .env and paste the values in yourself, from the password manager.
# Never commit .env and never paste its values into a chat.
# Variable names match the fields of src/optlab/config.py.

# Safety. This platform is paper-only: programs refuse to start if LIVE_TRADING is true.
TRADING_MODE=paper
LIVE_TRADING=false
# public = Deribit public market data, no key (Phases 1-7); test = Deribit testnet (Phase 8).
DERIBIT_ENV=public

# Database (Phase 1)
DATABASE_URL=

# Cloudflare R2 nightly backups (Phase 2). The bucket is btc-options-backup.
# R2_ENDPOINT contains the Cloudflare account ID: it goes only in .env, never in the repo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# healthchecks.io ping URLs (Phases 1-2). These are secrets.
HC_PING_URL_RECORDER=
HC_PING_URL_BACKUP=
HC_PING_URL_DISK=

# Cloudflare Tunnel for the public dashboard (Phase 6)
CLOUDFLARE_TUNNEL_TOKEN=

# Deribit testnet paper trading (Phase 8). Testnet only: no live keys ever exist.
DERIBIT_TESTNET_CLIENT_ID=
DERIBIT_TESTNET_CLIENT_SECRET=

# Optional: JEV (Phase 7, if it has a key) and Tardis (only if history is bought later)
JEV_API_KEY=
TARDIS_API_KEY=
